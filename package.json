{
  "name": "oficia-delicias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run check:android-env && npm run build:web && cap sync android && node scripts/verify-android-assets.mjs",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "check:android-env": "node scripts/check-android-env.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "2.117.3",
    "firebase": "12.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "react-native": "0.81.5",
    "supabase": "2.121.0",
    "typescript": "~5.9.2",
    "vite": "8.2.2"
  }
}
